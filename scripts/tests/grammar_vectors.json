                   {"write": "", "read": 2, "pause": 0, "checks": ["00ff:0005"]}], "issues": []},
        {"name": "leading pause", "field": "detection", "str": "=p250&0x00=0x0084",
         "steps": [{"write": "", "read": 0, "pause": 250, "checks": [":"]},
                   {"write": "00", "read": 2, "pause": 0, "checks": ["ffff:0084"]}], "issues": []},
        {"name": "pause before value", "field": "detection", "str": "0x01=p10 0x55",

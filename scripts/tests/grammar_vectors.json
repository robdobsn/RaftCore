        {"name": "semicolon separator", "field": "detection", "str": "0xfd=0x50;0xfe=0x5d",
         "steps": [{"write": "fd", "read": 1, "pause": 0, "checks": ["ff:50"]},
                   {"write": "fe", "read": 1, "pause": 0, "checks": ["ff:5d"]}], "issues": []},
        {"name": "uppercase hex and prefix", "field": "detection", "str": "0X010F=0xEBAA",

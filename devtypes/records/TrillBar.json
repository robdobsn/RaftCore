                { "n": "loc0", "t": ">H", "r": [0, 65535], "f": "d", "o": "uint16" },
                { "n": "loc1", "t": ">H", "r": [0, 65535], "f": "d", "o": "uint16" },
                { "n": "loc2", "t": ">H", "r": [0, 65535], "f": "d", "o": "uint16" },
                { "n": "loc3", "t": ">H", "r": [0, 65535], "f": "d", "o": "uint16" },
                { "n": "loc4", "t": ">H", "r": [0, 65535], "f": "d", "o": "uint16" },
                { "n": "size0", "t": ">H", "r": [0, 65535], "f": "d", "o": "uint16" },
                { "n": "size1", "t": ">H", "r": [0, 65535], "f": "d", "o": "uint16" },
                { "n": "size2", "t": ">H", "r": [0, 65535], "f": "d", "o": "uint16" },
                { "n": "size3", "t": ">H", "r": [0, 65535], "f": "d", "o": "uint16" },

                    "t": ">H",
                    "u": "&deg;C",
                    "r": [-40,125],
                    "d": 374.4914285714286,
                    "a": -45,
                    "f": "3.2f",
                    "o": "float"
                },
                {
                    "n": "humidity",
                    "at": 3,
                    "t": ">H",
                    "u": "%",
                    "r": [0,100],
                    "d": 655.36,
                    "f": "3.1f",
                    "o": "float"
                }
            ]
        }
    }
}

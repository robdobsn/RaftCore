{
    "_notes": "Bela Trill Square - 2D capacitive touch, 30 channels, up to 4 simultaneous touches. CENTROID mode returns 4 vertical loc+size pairs followed by 4 horizontal loc+size pairs. Address jumper-configurable 0x28-0x2F. Init, as Bela's Trill library (Trill-Linux) for the Square: CENTROID mode; prescaler 1; scan settings speed 0, 12 bits; a baseline update; noise threshold 40 (0x28 at 12 bits). Poll: up to 4 touches on each axis, vertical positions and sizes (vloc 0 to 1792, vsize) then horizontal (hloc 0 to 1792, hsize), as 4-element arrays; 65535 for no touch. Not bench tested since the init change (the Flex was: without the prescaler set, every channel read 4095 and no touch was seen). Source: the default mode, prescaler and noise threshold are from the defaults table of Bela's Trill library (https://github.com/BelaPlatform/Bela libraries/Trill, LGPL-3.0; also Trill-Linux); only those values and the sensor's documented commands are used, not the library's code (see RaftCore's THIRD_PARTY_NOTICES.md).",
    "addresses": "0x28-0x2F",
    "detectionValues": "0x00FF=p25&=0bXXXXXXXX00000010",
    "initValues": "0x000100=p15&0x000301=p15&0x0002000c=p15&0x0006=p30&0x000428=p15",
    "pollInfo": {
        "c": "0x04=r32",
        "i": 50,
        "s": 1
    },
    "scanPriority": "high",
    "hwProbeEffects": {
        "rsao": {
            "effect": "none",
            "basis": "source",
            "note": "Trill firmware v2: the first byte is a buffer offset and 0x99 is beyond the 64-byte buffer, so it is NACKed and ignored; reads have no side effects (BelaPlatform/Trill 537ebd6). Firmware v3 isn't public"
        }
    },
    "devInfoJson": {
        "name": "Trill Square",
        "desc": "Capacitive Touch Square",
        "manu": "Bela",
        "type": "TrillSquare",
        "clas": [
            "TCH"
        ],
        "resp": {
            "b": 32,
            "a": [
                {
                    "n": "vloc",
                    "t": ">H[4]",
                    "r": [
                        0,
                        1792
                    ],
                    "f": "d",
                    "o": "uint16"
                },
                {
                    "n": "vsize",
                    "t": ">H[4]",
                    "r": [
                        0,
                        65535
                    ],
                    "f": "d",
                    "o": "uint16"
                },
                {
                    "n": "hloc",
                    "t": ">H[4]",
                    "r": [
                        0,
                        1792
                    ],
                    "f": "d",
                    "o": "uint16"
                },
                {
                    "n": "hsize",
                    "t": ">H[4]",
                    "r": [
                        0,
                        65535
                    ],
                    "f": "d",
                    "o": "uint16"
                }
            ]
        },
        "actions": [
            {
                "n": "baseline",
                "w": "0006",
                "desc": "Update baseline"
            },
            {
                "n": "_conf.mode",
                "t": "B",
                "r": [
                    0,
                    3
                ],
                "d": 0,
                "desc": "Sensor mode",
                "map": {
                    "centroid": {
                        "w": "000100"
                    },
                    "raw": {
                        "w": "000101"
                    },
                    "baseline": {
                        "w": "000102"
                    },
                    "diff": {
                        "w": "000103"
                    }
                }
            },
            {
                "n": "_conf.noise",
                "t": "B",
                "w": "0004",
                "r": [
                    0,
                    255
                ],
                "d": 40,
                "desc": "Noise threshold (counts at 12 bits; 40 is the Trill library's default)"

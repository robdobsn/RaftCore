{
    "_notes": "Bela Trill Ring - 1D circular capacitive touch, 28 ring channels + 2 button channels, up to 5 touches. CENTROID response: 5 loc + 5 size + 2 button values (uint16 BE). Address jumper-configurable 0x38-0x3F. Init, as Bela's Trill library (Trill-Linux) for the Ring: CENTROID mode; prescaler 2; scan settings speed 0, 12 bits; a baseline update; noise threshold 40 (0x28 at 12 bits). Poll: up to 5 touches, positions (loc, 0 to 3584 = 28 x 128 over 28 channels; 65535 for no touch) then sizes (size, 0 for no touch) as 5-element arrays, then the two buttons (btn); the dashboard shows them with its touch strip visualizer (vt touchstrip). Not bench tested since the init change (the Flex was: without the prescaler set, every channel read 4095 and no touch was seen). Source: the default mode, prescaler and noise threshold are from the defaults table of Bela's Trill library (https://github.com/BelaPlatform/Bela libraries/Trill, LGPL-3.0; also Trill-Linux); only those values and the sensor's documented commands are used, not the library's code (see RaftCore's THIRD_PARTY_NOTICES.md).",
    "addresses": "0x38-0x3F",
    "detectionValues": "0x00FF=p25&=0bXXXXXXXX00000100",
    "initValues": "0x000100=p15&0x000302=p15&0x0002000c=p15&0x0006=p30&0x000428=p15",
    "pollInfo": {
        "c": "0x04=r24",
        "i": 50,
        "s": 1
    },
    "scanPriority": "high",
    "hwProbeEffects": {
        "rsao": {
            "effect": "none",
            "basis": "source",
            "note": "Trill firmware v2: the first byte is a buffer offset and 0x99 is beyond the 64-byte buffer, so it is NACKed and ignored; reads have no side effects (BelaPlatform/Trill 537ebd6). Firmware v3 isn't public"
        }
    },
    "devInfoJson": {
        "name": "Trill Ring",
        "desc": "Capacitive Touch Ring",
        "manu": "Bela",
        "type": "TrillRing",
        "clas": [
            "TCH",
            "BTN"
        ],
        "resp": {
            "b": 24,
            "a": [
                {
                    "n": "loc",
                    "t": ">H[5]",
                    "r": [
                        0,
                        3584
                    ],
                    "f": "d",
                    "o": "uint16",
                    "vt": "touchstrip",
                    "vo": {
                        "sizeAttr": "size",
                        "noValue": 65535,
                        "posMax": 3584,
                        "numChannels": 28,
                        "sizeMax": 5000
                    }
                },
                {
                    "n": "size",
                    "t": ">H[5]",
                    "r": [
                        0,
                        65535
                    ],
                    "f": "d",
                    "o": "uint16"
                },
                {
                    "n": "btn",
                    "t": ">H[2]",
                    "r": [
                        0,
                        65535
                    ],
                    "f": "d",
                    "o": "uint16"
                }
            ]
        },
        "actions": [
            {
                "n": "baseline",
                "w": "0006",
                "desc": "Update baseline"
            },
            {
                "n": "_conf.mode",
                "t": "B",
                "r": [
                    0,
                    3
                ],
                "d": 0,
                "desc": "Sensor mode",
                "map": {
                    "centroid": {
                        "w": "000100"
                    },
                    "raw": {
                        "w": "000101"
                    },
                    "baseline": {
                        "w": "000102"
                    },
                    "diff": {
                        "w": "000103"
                    }
                }
            },
            {
                "n": "_conf.noise",
                "t": "B",
                "w": "0004",
                "r": [
                    0,
                    255
                ],
                "d": 40,
                "desc": "Noise threshold (counts at 12 bits; 40 is the Trill library's default)"
            },
            {
                "n": "_conf.prescaler",
                "t": "B",
                "w": "0003",
                "r": [
                    1,
                    8
                ],
                "d": 2,
                "desc": "Prescaler (higher reads lower; raise it if channels saturate at 4095)"
            },
            {
                "n": "_conf.minsize",
                "t": ">H",
                "w": "0007",
                "r": [
                    0,
                    65535
                ],
                "d": 0,
                "desc": "Minimum touch size"
            }
        ]
    }
}
